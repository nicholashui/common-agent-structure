{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casops.local/schemas/video_generation_prompt.v2.sequence.json",
  "title": "Video Generation Prompt Specification v2 — Sequence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "spec_version",
    "kind",
    "sequence_id",
    "revision",
    "clips",
    "policy"
  ],
  "properties": {
    "schema": {
      "const": "video_generation_prompt_specification.v2"
    },
    "spec_version": {
      "const": "2.0.0"
    },
    "kind": {
      "const": "sequence"
    },
    "sequence_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "project_id": {
      "type": "string"
    },
    "intent": {
      "type": "object",
      "properties": {
        "logline": {
          "type": "string"
        }
      }
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clip_id", "order", "path"],
        "properties": {
          "clip_id": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "start_s": {
            "type": "number",
            "minimum": 0
          },
          "end_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string"
          },
          "logline": {
            "type": "string"
          }
        }
      }
    },
    "delivery": {
      "type": "object"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation_unit"],
      "properties": {
        "generation_unit": {
          "const": "clip"
        },
        "one_pass_one_clip": {
          "type": "boolean"
        },
        "concat": {
          "enum": ["post", "none"]
        }
      }
    },
    "provenance": {
      "type": "object"
    },
    "extensions": {
      "type": "object"
    }
  }
}
