# Host-owned LLM backends. Copy to `.env` (never commit `.env`).
# Secrets stay on the host. The Control UI never receives API keys.

# Fleet default. Agents inherit this unless an operator sets a per-agent override.
# local_deterministic | openai | xai | anthropic
DEFAULT_LLM=local_deterministic

# OpenAI (or any OpenAI-compatible endpoint)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# xAI Grok (OpenAI-compatible)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5
